+void LibusbDeviceHandler::log_iso_state(const char* event, const libusb_transfer* transfer,
+                                       std::uint32_t sequence, int libusb_error, int submit_errno) {
+    std::size_t tracked_iso = 0;
+    {
+        std::shared_lock lock(transfers_mutex_);
+        for (const auto& [seq, args] : transfers_) {
+            const auto* item = static_cast<libusb_transfer*>(args->transfer.get());
+            if (item->type == LIBUSB_TRANSFER_TYPE_ISOCHRONOUS) ++tracked_iso;
+        }
+    }
+    // On submit failure the rejected request has already been removed from the tracker.
+    write_iso_diagnostic(
+            "%s bus=%s session=%u endpoint=0x%02x seq=%u libusb=%d errno=%d bytes=%d packets=%d "
+            "pending_all=%zu tracked_iso=%zu iso_submitted=%llu iso_failed=%llu iso_callbacks=%llu "
+            "iso_cancel_requested=%llu iso_cancel_accepted=%llu iso_cancelled=%llu",
+            event, handle_device.busid.c_str(), iso_session_,
+            transfer ? static_cast<unsigned>(transfer->endpoint) : 0u, sequence, libusb_error, submit_errno,
+            transfer ? transfer->length : 0, transfer ? transfer->num_iso_packets : 0,
+            pending_count_.load(std::memory_order_relaxed), tracked_iso,
+            static_cast<unsigned long long>(iso_submitted_), static_cast<unsigned long long>(iso_failed_),
+            static_cast<unsigned long long>(iso_callbacks_.load(std::memory_order_relaxed)),
+            static_cast<unsigned long long>(iso_cancel_requested_), static_cast<unsigned long long>(iso_cancel_accepted_),
+            static_cast<unsigned long long>(iso_cancelled_.load(std::memory_order_relaxed)));
+}
+#endif
+
